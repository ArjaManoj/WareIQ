# ==============================================================================
# WareIQ Interactive Platform - Environment Variables Template
# Copy this file to .env in backend/ and .env.local in frontend/
# ==============================================================================

# Backend Configuration (backend/.env)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wareiq_demo?retryWrites=true&w=majority
JWT_SECRET=super_secret_wareiq_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Configuration (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_ENV=development
